# Apache config — URLs limpos sem .html
# (Vercel ignora este ficheiro; ver vercel.json para a config equivalente.)

RewriteEngine On

# 1) /index.html → /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) /name.html → /name  (preserva query string automaticamente)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Servir o .html quando o URL limpo é pedido
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
